{
  "name": "stitchbook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:ui": "npm run build && node scripts/check-ui.mjs",
    "check": "npm run check:tokens && npm run check:ui",
    "e2e": "node scripts/e2e.mjs",
    "test:trace": "npm run build && node scripts/trace-card-tests.mjs",
    "test:editor": "npm run build && node scripts/editor-tools-tests.mjs",
    "test:once": "node scripts/single-request-tests.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
