# Every environment variable Stitchbook reads, all empty here. Copy to .env and fill in what you
# need; an empty value means "use the default" (given in each comment). `make` loads .env.
# .env is gitignored: never commit it. Product numbers (stitch settings, limits, timeouts, rate
# limits) do NOT go here; they live in digitizer/src/digitizer/config.py.

# ---------- Supabase (Auth, database, Storage) ----------
# Set SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY to turn sign-in on: the API then requires a
# signed-in user on every route except /health, /site, /formats, /config, and keeps designs in
# Supabase. Leave both empty for local mode (no sign-in, one local user, files in STORAGE_DIR).
# Setup: docs/supabase-setup.md.

# Project URL, e.g. https://<project-ref>.supabase.co. Read by the API and, at build time, by the
# web app (vite.config.ts passes it to the browser).
SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser: the web app gets it at build time, and
# the API sends it with the signed-in user's token, so row level security applies.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). SERVER SIDE ONLY, never in the browser: the web build is checked
# for it (npm run check:secrets). The running API does not use it; only the live isolation tests
# (api/tests/test_supabase_live.py) use it, to create and delete their two test users.
SUPABASE_SECRET_KEY=

# ---------- API and worker ----------
# Redis connection used by the API (to enqueue jobs) and the worker (to run them).
# Default: redis://localhost:6379/0
REDIS_URL=

# Name of the RQ queue the API enqueues digitizing jobs on and the worker listens to. Default: digitize
RQ_QUEUE=

# Port `make api` serves the FastAPI app on. Default: 8000
API_PORT=

# The one browser origin allowed to call the API (the web app), exact, never "*".
# Empty = no CORS (the web app on another port cannot call the API). For `make web`: http://localhost:8080
CORS_ORIGIN=

# Folder where the API stores uploads, machine files and previews in local mode. Default: data/storage
STORAGE_DIR=

# Set to 1 to run the API with the stand-in TEST_RUN_OVERRIDES from config.py while product
# values are still unchosen. Local trying-out only: files made this way are not for sewing.
STITCHBOOK_TEST_RUN_VALUES=

# Function the worker runs for "Create satin columns". Empty = the real one.
# Tests set stitchbook_worker.testing.slow_trace_design (the real trace, stretched out) to see and
# cancel the queued and running states.
STITCHBOOK_TRACE_JOB=

# Log level for the API and worker: debug, info, warning, error. Default: info
LOG_LEVEL=

# ---------- Web app ----------
# Port `make web` serves the front end (Vite dev server) on. Keep CORS_ORIGIN in step with it. Default: 8080
WEB_PORT=

# Address of the API that the web app calls. Read by Vite at build time. Default: http://localhost:8000
VITE_API_URL=

# Folder of blog posts (Markdown), relative to web/. Default: content/blog. Only the page tests
# change it (to a fixture folder).
STITCHBOOK_BLOG_DIR=
