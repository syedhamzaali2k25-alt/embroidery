# Copy to .env and fill in. `make` loads .env automatically.
# Product numbers (stitch settings, limits, timeouts, rate limits) do NOT go here;
# they live in digitizer/src/digitizer/config.py.

# Redis connection used by the API (to enqueue jobs) and the worker (to run them).
REDIS_URL=redis://localhost:6379/0

# Name of the RQ queue the API enqueues digitizing jobs on and the worker listens to.
RQ_QUEUE=digitize

# Port `make api` serves the FastAPI app on.
API_PORT=8000

# Port `make web` serves the front end (Vite dev server) on. Keep CORS_ORIGIN in step with it.
WEB_PORT=8080

# Address of the API that the web app (Upload and Preview screens) calls. Read by Vite at build time.
VITE_API_URL=http://localhost:8000

# The one browser origin allowed to call the API (the web app), exact, never "*". Empty = no CORS.
CORS_ORIGIN=http://localhost:8080

# Folder where the API stores uploads, DST files and previews (local-disk Storage).
STORAGE_DIR=data/storage

# Set to 1 to run the API with the stand-in TEST_RUN_OVERRIDES from config.py while product
# values are still unchosen. Local trying-out only: files made this way are not for sewing.
STITCHBOOK_TEST_RUN_VALUES=

# Function the worker runs for "Create satin columns". Leave empty for the real one.
# Tests set stitchbook_worker.testing.slow_trace_design (the real trace, stretched out) to see and
# cancel the queued and running states.
STITCHBOOK_TRACE_JOB=

# Log level for the API and worker: debug, info, warning, error.
LOG_LEVEL=info

# Supabase project URL (Postgres, Auth, Storage). Not read by any code yet.
SUPABASE_URL=

# Supabase public anon key, safe for the browser. Not read by any code yet.
SUPABASE_ANON_KEY=

# Supabase service-role key: server-side only (API/worker), never ship to the browser. Not read by any code yet.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket that holds uploads, embroidery files and previews. Not read by any code yet.
SUPABASE_STORAGE_BUCKET=
